rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /temporary-uploads/{roomId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.owner == true && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('audio/.*');
    }
  }
}
