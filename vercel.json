{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/songs/:category",
      "destination": "/api/songs?category=:category"
    },
    {
      "source": "/room/:roomId",
      "destination": "/room?room=:roomId"
    },
    {
      "source": "/owner-login/:roomId",
      "destination": "/owner-login?room=:roomId"
    }
  ]
}
